    "@tauri-apps/api": "^2.11.1",
    "color": "4.2.1",
    "fitty": "2.3.6",
    "formik": "2.2.9",
    "re-resizable": "6.9.2",
    "react": "18.2.0",
    "react-color": "2.19.3",
